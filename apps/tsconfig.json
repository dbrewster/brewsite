{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@brewsite/core": ["../packages/core/src/index.ts"],
      "@brewsite/core/hud/animejs": ["examples/src/widgets/hud-animejs/index"],
      "@brewsite/core/*": ["../packages/core/src/*"],
      "@brewsite/model": ["../packages/model/src/index.ts"],
      "@brewsite/diagram": ["../packages/diagram/src/index.ts"],
      "@brewsite/diagram/*": ["../packages/diagram/src/*"],
      "@brewsite/charts": ["../packages/charts/src/index.ts"],
      "@brewsite/charts/*": ["../packages/charts/src/*"],
      "@brewsite/slides": ["../packages/slides/src/index.ts"],
      "@brewsite/slides/*": ["../packages/slides/src/*"],
      "@brewsite/themes": ["../packages/themes/src/index.ts"],
      "@brewsite/themes/*": ["../packages/themes/src/*"],
      "@brewsite/docs": ["../packages/docs/src/index.ts"],
      "@brewsite/docs/*": ["../packages/docs/src/*"]
    },
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": [
    "./vite-env.d.ts",
    "./App.tsx",
    "./main.tsx",
    "./docs/src/**/*.ts",
    "./docs/src/**/*.tsx",
    "./website/src/**/*.ts",
    "./website/src/**/*.tsx",
    "./examples/src/**/*.ts",
    "./examples/src/**/*.tsx",
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "examples/generated/**",
    "website/src/generated/**",
    "docs/src/generated/**"
  ]
}
