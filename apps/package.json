{
  "name": "@brewsite/apps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "pnpm gen:scene-dsl && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "gen:scene-dsl": "node ../scripts/gen-scene-dsl.mjs --input examples/siteResources.ts --out-dir examples/generated --asset-root examples/public --manifest-out examples/public/scene-manifest.json",
    "gen:scene-dsl:website": "node ../scripts/gen-scene-dsl.mjs --input website/siteResources.ts --out-dir website/src/generated --asset-root website/public --manifest-out website/public/scene-manifest.json"
  },
  "dependencies": {
    "@brewsite/core": "workspace:*",
    "@brewsite/diagram": "workspace:*",
    "@brewsite/model": "workspace:*",
    "animejs": "^3.2.2",
    "fflate": "^0.8.2",
    "opentype.js": "^1.3.4",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
