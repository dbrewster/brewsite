{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@brewsite/core": ["../core/src/index.ts"],
      "@brewsite/core/testing": ["../core/src/testing.ts"],
      "@brewsite/core/compiler/registry": ["../core/src/compiler/registry.ts"],
      "@brewsite/core/compiler/sceneTypes": ["../core/src/compiler/sceneTypes.ts"],
      "@brewsite/core/compiler/transitions/transitionTypes": ["../core/src/compiler/transitions/transitionTypes.ts"],
      "@brewsite/core/runtime/types": ["../core/src/runtime/types.ts"],
      "@brewsite/core/widget/types": ["../core/src/widget/types.ts"],
      "@brewsite/core/widget/WidgetPlugin": ["../core/src/widget/WidgetPlugin.ts"],
      "@brewsite/core/widget/WidgetRegistry": ["../core/src/widget/WidgetRegistry.ts"]
    },
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.test.*"]
}
