{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@brewsite/core": ["../packages/core/src/index.ts"],
      "@brewsite/core/*": ["../packages/core/src/*"],
      "@brewsite/diagram": ["../packages/diagram/src/index.ts"],
      "@brewsite/diagram/*": ["../packages/diagram/src/*"],
      "@brewsite/model": ["../packages/model/src/index.ts"],
      "@brewsite/model/*": ["../packages/model/src/*"],
      "@brewsite/docs": ["../packages/docs/src/index.ts"],
      "@brewsite/docs/*": ["../packages/docs/src/*"]
    },
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../packages/core/src/types/process.d.ts"],
  "exclude": ["node_modules", "dist", "vite.config.ts", "src/generated"]
}
