{
  "name": "brewflow-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config examples/vite-app/vite.config.ts",
    "gen:scene-dsl": "node scripts/gen-scene-dsl.mjs --input examples/simple/sceneResources.ts --out-dir examples/simple/generated --manifest-out public/assets/scene-manifest.json",
    "build": "pnpm gen:scene-dsl && tsc -b && vite build && node scripts/prune-dist.mjs",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "meshoptimizer": "^0.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@testing-library/react": "^16.3.2",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "fbx2gltf": "0.9.7-p1",
    "jsdom": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
